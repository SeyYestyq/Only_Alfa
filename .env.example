# Only_Alfa — эталон окружения (ТЗ v3.2 / Этап 0)
# Скопируйте в .env:  cp .env.example .env

# PostgreSQL 16 (в docker compose подставляется автоматически)
DATABASE_URL=postgresql+psycopg://alfa:alfa@db:5432/alfa

# Ключевая ставка ЦБ РФ (% годовых). Сверка перед стоп-кодом 26.10.
CBR_KEY_RATE=14.0

# ИИ-контур: по умолчанию детерминированный поиск <= 50 мс без сети/GPU
AI_PROVIDER_MODE=DETERMINISTIC
# AI_PROVIDER_MODE=OPENAI_COMPATIBLE
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL_NAME=
OPENAI_TIMEOUT_MS=1500

# CORS для SPA (Vite / nginx)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
