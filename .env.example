# Only_Alfa — эталон окружения (ТЗ v3.2, этап 0).
# Скопируйте в .env: cp .env.example .env
# Здесь только несекретные значения по умолчанию; реальные ключи в репозиторий не попадают.

# --- PostgreSQL 16 (docker compose) ---
# Значения совпадают с дефолтами в docker-compose.yml — менять не обязательно.
POSTGRES_DB=alfadb
POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa
# Строка подключения внутри docker-сети: backend обращается к БД по имени сервиса db.
DATABASE_URL=postgresql+psycopg://alfa:alfa@db:5432/alfadb
# Локальный запуск без Docker (uvicorn): раскомментируйте и закомментируйте строку выше.
# DATABASE_URL=sqlite:///./alfa.db

# --- Ключевая ставка ЦБ РФ, % годовых ---
# Используется в расчётах лимита и стоп-факторах; сверять перед демо.
CBR_KEY_RATE=14.0

# --- ИИ-контур ---
# DETERMINISTIC — офлайн-движок без сети (режим демо по умолчанию).
# OPENAI_COMPATIBLE — внешний LLM; при пустых значениях ниже остаётся детерминированный фолбэк.
AI_PROVIDER_MODE=DETERMINISTIC
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL_NAME=
# Таймаут внешнего провайдера, мс: дольше — сразу фолбэк, чтобы не рвать SLA поиска.
OPENAI_TIMEOUT_MS=1500

# --- CORS для SPA ---
# Через запятую: dev-сервер Vite и nginx-раздача из docker compose.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
